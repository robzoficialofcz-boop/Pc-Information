<Application x:Class="PcInformation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0B1020"/>
        <SolidColorBrush x:Key="Panel" Color="#151D31"/>
        <SolidColorBrush x:Key="Panel2" Color="#1C2740"/>
        <SolidColorBrush x:Key="TextMain" Color="#F3F6FC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#98A6C3"/>
        <SolidColorBrush x:Key="Accent" Color="#4DA3FF"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Application.Resources>
</Application>