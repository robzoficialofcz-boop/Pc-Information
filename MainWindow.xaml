<Window x:Class="PcInformation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pc Information" Icon="app.ico" Height="850" Width="1360"
        MinHeight="600" MinWidth="800" ResizeMode="CanResize" WindowStyle="SingleBorderWindow" Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="PC INFORMATION" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="MONITORAMENTO DE HARDWARE EM TEMPO REAL" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="1,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="#35D39A" Margin="0,0,8,0"/>
                <TextBlock Text="MONITORAMENTO ATIVO" Foreground="#35D39A" FontWeight="SemiBold" FontSize="11"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="16" Margin="0,0,0,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="ComputerNameText" Text="COMPUTADOR" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WindowsText" Text="Detectando Windows..." Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/></StackPanel>
                <TextBlock x:Name="UpdatedText" Grid.Column="1" Text="Atualizando..." Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="4" Rows="1" Margin="0,0,0,16">
                    <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="17" Margin="0,0,12,0"><StackPanel>
                        <TextBlock Text="PROCESSADOR" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="CpuUsageText" Text="--%" FontSize="31" FontWeight="Bold" Margin="0,9,0,2"/>
                        <TextBlock x:Name="CpuNameText" Text="Detectando CPU..." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="CpuBar" Height="6" Margin="0,13,0,0" Maximum="100"/>
                        <TextBlock x:Name="CpuTempText" Text="Temperatura: indisponível" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                    <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="17" Margin="0,0,12,0"><StackPanel>
                        <TextBlock Text="MEMÓRIA RAM" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="RamUsageText" Text="-- GB" FontSize="31" FontWeight="Bold" Margin="0,9,0,2"/>
                        <TextBlock x:Name="RamDetailText" Text="Calculando..." Foreground="{StaticResource TextMuted}"/>
                        <ProgressBar x:Name="RamBar" Height="6" Margin="0,13,0,0" Maximum="100"/>
                        <TextBlock x:Name="RamPercentText" Text="--% utilizado" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                    <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="17" Margin="0,0,12,0"><StackPanel>
                        <TextBlock Text="PLACA DE VÍDEO" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="GpuUsageText" Text="--%" FontSize="31" FontWeight="Bold" Margin="0,9,0,2"/>
                        <TextBlock x:Name="GpuNameText" Text="Detectando GPU..." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="GpuBar" Height="6" Margin="0,13,0,0" Maximum="100"/>
                        <TextBlock x:Name="GpuDetailText" Text="VRAM: indisponível" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                    <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="17"><StackPanel>
                        <TextBlock Text="ARMAZENAMENTO" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="DiskUsageText" Text="-- GB" FontSize="31" FontWeight="Bold" Margin="0,9,0,2"/>
                        <TextBlock x:Name="DiskDetailText" Text="Calculando..." Foreground="{StaticResource TextMuted}"/>
                        <ProgressBar x:Name="DiskBar" Height="6" Margin="0,13,0,0" Maximum="100"/>
                        <TextBlock x:Name="DiskPercentText" Text="--% utilizado" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                </UniformGrid>
                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,0,12,0"><StackPanel>
                        <TextBlock Text="DETALHES DO HARDWARE" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <TextBlock Text="PLACA-MÃE" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="BoardText" Text="Detectando..." Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="BIOS" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="BiosText" Text="Detectando..." Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="PROCESSADOR" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="CpuDetailText" Text="Detectando..." Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="SISTEMA" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="SystemDetailText" Text="Detectando..." Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel></Border>
                    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="18"><StackPanel>
                        <TextBlock Text="REDE E ATIVIDADE" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <TextBlock Text="DOWNLOAD" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="DownloadText" Text="0 KB/s" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,14"/>
                        <TextBlock Text="UPLOAD" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="UploadText" Text="0 KB/s" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,14"/>
                        <TextBlock Text="UNIDADES" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="DrivesText" Text="Verificando unidades..." TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel></Border>
                </Grid>
                <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18"><StackPanel>
                    <TextBlock Text="OBSERVAÇÕES DO MONITORAMENTO" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="StatusText" Text="Iniciando coleta de informações..." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Text="Pc Information • Leituras locais • Alguns sensores dependem do hardware, driver e permissões."
                   Foreground="{StaticResource TextMuted}" FontSize="10" Margin="2,14,0,0"/>
    </Grid>
</Window>